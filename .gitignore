# runtime state — never commit accounts, progress, or secrets
infra/web/data/*
!infra/web/data/.gitkeep
.env
infra/.env

# the live manifest — assembled by `just setup` (flag.txt + symlinked meta/readme)
/active-challenges/

# wildcard TLS cert served by Traefik — self-signed by setup or supplied by the operator
infra/traefik/certs/

# handout captures are generated (private solutions repo builders) and dropped in here
# at deploy time — never commit them (they contain the sniffable answer)
infra/web/static/files/*.pcap

# the other two repos live nested here (see README "Repositories")
/challenges/
/solutions/

# local agent/editor state
/.claude/

# python
__pycache__/
*.pyc

# generated by scripts/gen-routes.sh at `just up`
infra/traefik/dynamic/routes.yml
# generated by `just vault-up` — holds the leaked SNI host, keep it out of the repo
infra/traefik/dynamic/vault.yml
